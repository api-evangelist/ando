          "name": "Open a realtime connection",
          "request": {
            "name": "Open a realtime connection",
            "description": {
              "content": "Opens a temporary pre-authorized public realtime websocket connection URL for RFC 085 ProductEvent delivery. API keys are validated only on this HTTP route; the websocket uses the returned temporary ticket URL and the ando.realtime.v1 subprotocol.",
