{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ando Public Calls Realtime API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Realtime",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Open a realtime connection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ando.so/v1/realtime/connections",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Opens a temporary pre-authorized public realtime websocket connection URL for RFC 085 ProductEvent delivery. API keys are validated only on this HTTP route; the websocket uses the returned temporary ticket URL and the ando.realtime.v1 subprotocol."
        }
      ]
    }
  ],
  "bundled": true
}