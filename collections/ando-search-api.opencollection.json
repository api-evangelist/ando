{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ando Public Calls Search API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search calls",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ando.so/v1/search/calls",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query text."
              },
              {
                "name": "conversation",
                "value": "",
                "type": "query",
                "description": "Comma-separated conversation identifiers to filter to."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Cursor or ISO timestamp after which results should be returned."
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Cursor or ISO timestamp before which results should be returned."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Searches calls accessible to the authenticated API key."
        },
        {
          "info": {
            "name": "Search clipboards",
            "type": "http"
