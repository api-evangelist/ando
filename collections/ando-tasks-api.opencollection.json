{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ando Public Calls Tasks API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ando.so/v1/search/tasks",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query text. When omitted, returns the default task list ordering."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Searches tasks visible to the authenticated API key."
        },
        {
          "info": {
            "name": "Get a task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ando.so/v1/tasks/:taskId",
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task identifier."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns task context, including task entries and resources."
        },
        {
          "info": {
            "name": "Record a task update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ando.so/v1/tasks/:taskId/updates",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "taskId",
                "value": "",
                "type": "path",
                "description": "Task identifier."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Records a task update and optional task/resource changes."
        }
      ]
    }
  ],
  "bundled": true
}